# Local toolchain and environments (portable Node lives in .tools/)
.tools/
.venv/
node_modules/
frontend/dist/
__pycache__/
*.pyc
.pytest_cache/

# Generated state: datasets, indexes, model weights, run results, databases.
# All of it is reproducible with scripts/ (see README).
artifacts/
data/
!data/README.md
*.sqlite3
*.db
reports/raw/

# Learning-book build outputs (regenerated by docs/learning/build/build.py)
docs/learning/build/out/
docs/learning/build/preview/

# TypeScript incremental build state
*.tsbuildinfo

# Secrets and machine-local configuration - never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Logs, coverage and test caches
*.log
logs/
.coverage
htmlcov/
coverage/
.vitest/

# Editor and OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local challenge materials (organisers' data and documents are never published)
reference material/
reference_material/
*.jsonl.gz
